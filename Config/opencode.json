{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "ark/ark-code-latest",
  "agent": {
    "compaction": {
      "model": "ark/doubao-seed-2.0-mini",
      "options": {
        "reasoningEffort": "minimal"
      }
    }
  },
  "memory": {
    "model": "ark/doubao-seed-2.0-mini"
  },
  "indexing": {
    "enabled": true,
    "provider": "openai-compatible",
    "model": "doubao-embedding-vision",
    "dimension": 1024,
    "vectorStore": "lancedb",
    "openai-compatible": {
      "apiKey": "",
      "baseUrl": "https://ark.cn-beijing.volces.com/api/plan/v3"
    }
  },
  "watcher": {
    "ignore": [
      "Data/**",
      ".venv*",
      ".dataprep_status/**",
      "**/*.nii.gz",
      "**/*.nii",
      "__pycache__",
      ".kilo/**",
      "node_modules/**",
      "0_Logs/**",
      "2_QuickStart/**/runs/**/data_roots/**",
      "**/*.pth",
      "**/*.ckpt",
      "**/*.safetensors",
      "**/*.h5",
      "**/*.npz",
      "**/*.pkl",
      "**/*.pt",
      "**/*.bin",
      "**/*.onnx",
      "**/*.log",
      "**/*.out"
    ]
  },
  "provider": {
    "ark": {
      "name": "Volcano Ark (Exclusive API Key)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "",
        "baseURL": "https://ark.cn-beijing.volces.com/api/plan/v3"
      },
      "models": {
        "ark-code-latest": {
          "name": "Ark(VolcanoEngine) Auto: effect+speed",
          "limit": { "context": 256000, "output": 131072 }
        },
        "doubao-seed-2.0-code": {
          "name": "Doubao Seed 2.0 Code",
          "limit": { "context": 256000, "output": 131072 }
        },
        "doubao-seed-2.0-pro": {
          "name": "Doubao Seed 2.0 Pro",
          "limit": { "context": 256000, "output": 131072 }
        },
        "doubao-seed-2.0-lite": {
          "name": "Doubao Seed 2.0 Lite",
          "limit": { "context": 256000, "output": 131072 }
        },
        "doubao-seed-2.0-mini": {
          "name": "Doubao Seed 2.0 Mini",
          "limit": { "context": 256000, "output": 131072 }
        },
        "doubao-seed-code": {
          "name": "Doubao Seed Code",
          "limit": { "context": 256000, "output": 32768 }
        },
        "doubao-seed-evolving": {
          "name": "Doubao Seed Evolving (Coding & Agent, weekly upgrade)",
          "limit": { "context": 1000000, "output": 262144 }
        },
        "minimax-latest": {
          "name": "MiniMax M2.7",
          "limit": { "context": 200000, "output": 131072 }
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "limit": { "context": 1000000, "output": 131072 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1000000, "output": 393216 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 1000000, "output": 393216 }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": { "context": 256000, "output": 32768 }
        },
        "doubao-seedance-2.0": {
          "name": "Doubao Seedance 2.0 (Vision)"
        },
        "doubao-seedance-2.0-fast": {
          "name": "Doubao Seedance 2.0 Fast (Vision)"
        },
        "doubao-seedance-1.5-pro": {
          "name": "Doubao Seedance 1.5 Pro (Vision)"
        },
        "doubao-seedream-5.0-lite": {
          "name": "Doubao Seedream 5.0 Lite (Vision)"
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "*": {
      "*": "allow"
    }
  }
}
